# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters

# Optional: PostgreSQL persistence. Without this, accounts are stored locally in
# .smady-auth-store.json (which is ignored by Git).
# DATABASE_URL=postgresql://user:password@host:5432/database
